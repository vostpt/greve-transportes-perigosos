APP_NAME="Já Não Dá Para Abastecer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT
APP_TIMEZONE=Europe/Lisbon

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=greve
DB_USERNAME=greve
DB_PASSWORD=greve

SESSION_DRIVER=redis
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

MAIL_MAILER=log

## TRUSTED_PROXIES — CIDR list (comma-separated) of proxies allowed to forward
## X-Forwarded-* headers. In production, restrict to the Cloudflare ranges you
## actually terminate through, e.g.:
## TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,141.101.64.0/18
## In Docker development, "*" trusts the local nginx container.
TRUSTED_PROXIES=*

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

ERRORS_SPREADSHEET_LINK=

FUELSTATIONS_SOURCE1=
FUELSTATIONS_SOURCE2=

API_V1_DOWNLOAD_API_CSV=devpass

GOOGLE_RECAPTCHA_V3_SECRET=
GOOGLE_RECAPTCHA_V3_SITE_KEY=

MAPBOX_TOKEN=
MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

VITE_APP_NAME="${APP_NAME}"
